// Ручная проверка ссылочных полей формы harness77 в любой базе (задача 012).
// Форма и копия метаданных — из ERT прогона R1 (base-for-test); модуль данных базы
// не читает. «Проверка» сообщает по каждому из шести полей тип, вид и значение;
// значения можно перед этим выбрать через «...» или F4.

Функция Harness77Вид(Значение)
    Тип77 = ТипЗначенияСтр(Значение);
    Вид77 = "-";
    Если Тип77 <> "ВидСубконто" Тогда
        Попытка
            Если Тип77 = "Счет" Тогда
                Вид77 = Значение.ПланСчетов().Идентификатор();
            Иначе
                Вид77 = Значение.Вид();
            КонецЕсли;
        Исключение
            Вид77 = "? " + ОписаниеОшибки();
        КонецПопытки;
    КонецЕсли;
    Возврат Вид77;
КонецФункции

Процедура Harness77Поле(Имя, Значение)
    Сообщить(Имя + ": тип " + ТипЗначенияСтр(Значение) + ", вид " + Harness77Вид(Значение)
        + ", значение «" + СокрЛП(Строка(Значение)) + "»");
КонецПроцедуры

Процедура Harness77Нажатие()
    Сообщить("Проверка полей harness77:");
    Harness77Поле("Контрагент77", Контрагент77);
    Harness77Поле("Справочник77", Справочник77);
    Harness77Поле("Документ77", Документ77);
    Harness77Поле("Пол77", Пол77);
    Harness77Поле("Счет77", Счет77);
    Harness77Поле("ВидСубконто77", ВидСубконто77);
КонецПроцедуры

Процедура Выполнить()
КонецПроцедуры

Процедура Очистить()
КонецПроцедуры
