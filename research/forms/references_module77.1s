// Модуль проб ссылочных полей формы harness77 (задача 012), шаблон — FIO.ERT, база base-for-test.
//
// При открытии кладёт в шесть ссылочных полей значения базы и запоминает исходные
// значения. «Проверка» добавляет clicked:<n>, затем для каждого поля
// value:<имя>=<ТипЗначенияСтр>|<вид>|same:<равно исходному>|empty:<ПустоеЗначение>
// и repr:<имя>=<Строка(значение)>: представление зависит от данных базы, адаптер
// держит эти строки отдельно от значения. Вид — Вид(), у счёта — идентификатор
// плана счетов, у вида субконто — «-»; ошибка обращения — «?».
// Вариант R3 (строка Вариант77 меняется при подготовке): последним в поле вида
// Справочник.Контрагенты присваивается элемент Справочник.Сотрудники.
Перем Нажатий77;
Перем ИсхКонтрагент77;
Перем ИсхСправочник77;
Перем ИсхДокумент77;
Перем ИсхПол77;
Перем ИсхСчет77;
Перем ИсхВидСубконто77;

Процедура Harness77Добавить(Текст)
    Если ТипЗначенияСтр(Форма.Параметр) = "СписокЗначений" Тогда
        Форма.Параметр.ДобавитьЗначение(Текст);
    КонецЕсли;
КонецПроцедуры

Функция Harness77Вид(Значение)
    Тип77 = ТипЗначенияСтр(Значение);
    Вид77 = "-";
    Если Тип77 <> "ВидСубконто" Тогда
        Попытка
            Если Тип77 = "Счет" Тогда
                Вид77 = Значение.ПланСчетов().Идентификатор();
            Иначе
                Вид77 = Значение.Вид();
            КонецЕсли;
        Исключение
            Вид77 = "?";
        КонецПопытки;
    КонецЕсли;
    Возврат Вид77;
КонецФункции

Процедура Harness77Поле(Имя, Значение, Исходное)
    Harness77Добавить("value:" + Имя + "=" + ТипЗначенияСтр(Значение) + "|" + Harness77Вид(Значение)
        + "|same:" + ?(Значение = Исходное, "1", "0") + "|empty:" + СокрЛП(Строка(ПустоеЗначение(Значение))));
    Harness77Добавить("repr:" + Имя + "=" + СокрЛП(Строка(Значение)));
КонецПроцедуры

Функция Harness77ПервыйЭлемент(Вид)
    Спр77 = СоздатьОбъект("Справочник." + Вид);
    Спр77.ВыбратьЭлементы(0);
    Пока Спр77.ПолучитьЭлемент() = 1 Цикл
        Если Спр77.ЭтоГруппа() = 0 Тогда
            Возврат Спр77.ТекущийЭлемент();
        КонецЕсли;
    КонецЦикла;
    Возврат 0;
КонецФункции

Процедура Harness77Нажатие()
    Нажатий77 = Нажатий77 + 1;
    Harness77Добавить("clicked:" + СокрЛП(Строка(Нажатий77)));
    Harness77Поле("Контрагент77", Контрагент77, ИсхКонтрагент77);
    Harness77Поле("Справочник77", Справочник77, ИсхСправочник77);
    Harness77Поле("Документ77", Документ77, ИсхДокумент77);
    Harness77Поле("Пол77", Пол77, ИсхПол77);
    Harness77Поле("Счет77", Счет77, ИсхСчет77);
    Harness77Поле("ВидСубконто77", ВидСубконто77, ИсхВидСубконто77);
КонецПроцедуры

Процедура Выполнить()
КонецПроцедуры

Процедура Очистить()
КонецПроцедуры

Процедура ПриОткрытии()
    Вариант77 = "R1";
    Нажатий77 = 0;
    ИсхКонтрагент77 = Harness77ПервыйЭлемент("Контрагенты");
    Контрагент77 = ИсхКонтрагент77;
    ИсхСправочник77 = Harness77ПервыйЭлемент("Сотрудники");
    Справочник77 = ИсхСправочник77;
    Док77 = СоздатьОбъект("Документ.Выписка");
    Если Док77.ВыбратьДокументы(Дата(1990, 1, 1), Дата(2030, 12, 31)) = 1 Тогда
        Если Док77.ПолучитьДокумент() = 1 Тогда
            ИсхДокумент77 = Док77.ТекущийДокумент();
        КонецЕсли;
    КонецЕсли;
    Документ77 = ИсхДокумент77;
    ИсхПол77 = Перечисление.Пол.Женский;
    Пол77 = ИсхПол77;
    ИсхСчет77 = СчетПоКоду("51");
    Счет77 = ИсхСчет77;
    ИсхВидСубконто77 = ВидыСубконто.Контрагенты;
    ВидСубконто77 = ИсхВидСубконто77;
    Если Вариант77 = "R3" Тогда
        Попытка
            Контрагент77 = ИсхСправочник77;
            ИсхКонтрагент77 = ИсхСправочник77;
        Исключение
            Harness77Добавить("assign-error:" + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
    Harness77Добавить("loaded:harness77-form");
КонецПроцедуры
