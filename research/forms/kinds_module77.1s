// Модуль проб сверки видов по именам (задача 013), шаблон — Договор_Оргтехники.ert.
//
// Данных базы не читает. При открытии для каждого поля вида добавляет
// value:<имя>=<ТипЗначенияСтр>|<Вид()> в параметр формы; вне harness (параметр —
// не список) — Сообщить, поэтому ту же ERT можно открыть в любой базе. Поле без
// типа даёт «Строка|?». Строку-метку полей подготовка заменяет вызовами
// Harness77Поле по полям своего случая. ПечатьОлд() — формула кнопки «Печать»
// шаблона, здесь пустая.

Процедура Harness77Добавить(Текст)
    Если ТипЗначенияСтр(Форма.Параметр) = "СписокЗначений" Тогда
        Форма.Параметр.ДобавитьЗначение(Текст);
    Иначе
        Сообщить(Текст);
    КонецЕсли;
КонецПроцедуры

Функция Harness77Вид(Значение)
    Вид77 = "?";
    Попытка
        Вид77 = Значение.Вид();
    Исключение
        Вид77 = "?";
    КонецПопытки;
    Возврат Вид77;
КонецФункции

Процедура Harness77Поле(Имя, Значение)
    Harness77Добавить("value:" + Имя + "=" + ТипЗначенияСтр(Значение) + "|" + Harness77Вид(Значение));
КонецПроцедуры

Процедура ПечатьОлд()
КонецПроцедуры

Процедура ПриОткрытии()
    // harness77: поля
    Harness77Добавить("loaded:harness77-form");
КонецПроцедуры
