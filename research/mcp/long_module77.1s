// Внешняя обработка пробы отмены задачи 014 (N2, N3): контракт этапа 4, но контрольная
// функция занята 150 с, чтобы отмену через MCP получил идущий расчёт. Данных базы
// не читает. Мягкого прерывания модуля нет: отмена останавливает свою 1С.
Функция Секунды77()
    Перем Час, Минута, Секунда;
    ТекущееВремя(Час, Минута, Секунда);
    Возврат Час * 3600 + Минута * 60 + Секунда;
КонецФункции

Функция Harness77Контроль() Экспорт
    Начало77 = Секунды77();
    Пока (Секунды77() - Начало77 + 86400) % 86400 < 150 Цикл
    КонецЦикла;
    Возврат 6 * 7;
КонецФункции

Процедура Выполнить()
КонецПроцедуры

Процедура Очистить()
КонецПроцедуры

Процедура ПриОткрытии()
    СтатусВозврата(0);
    Параметры77 = Форма.Параметр;
    Команда77 = Параметры77.ПолучитьЗначение(1);
    Параметры77.ДобавитьЗначение("loaded:harness77");
    Если Команда77 = "execute" Тогда
        Попытка
            Ответ77 = Harness77Контроль();
            Параметры77.ДобавитьЗначение("value:" + СокрЛП(Строка(Ответ77)));
        Исключение
            Параметры77.ДобавитьЗначение("runtime-error:" + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
    Параметры77.ДобавитьЗначение("completed:harness77");
КонецПроцедуры
