Функция Harness77Answer(А, Б) Экспорт
    Возврат А + Б;
КонецФункции

Процедура Harness77Unused()
    Локальное77 = 1;
КонецПроцедуры

Процедура Выполнить()
КонецПроцедуры

Процедура Очистить()
КонецПроцедуры

Процедура ПриОткрытии()
    СтатусВозврата(0);
    Параметры77 = Форма.Параметр;
    Команда77 = Параметры77.ПолучитьЗначение(1);
    Параметры77.ДобавитьЗначение("loaded:__IDENTITY__");
    Если Команда77 = "execute" Тогда
        Попытка
            Ответ77 = Harness77Answer(20, __ARGUMENT__);
            Параметры77.ДобавитьЗначение("value:" + СокрЛП(Строка(Ответ77)));
        Исключение
            Параметры77.ДобавитьЗначение("runtime-error:" + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
    Если Команда77 = "wait" Тогда
        Предупреждение("HARNESS77 controlled modal wait __IDENTITY__");
    КонецЕсли;
    Параметры77.ДобавитьЗначение("completed:__IDENTITY__");
КонецПроцедуры
