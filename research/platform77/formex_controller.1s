// In-memory module executed via 1CPP, within the owned OLE session.
Функция Harness77FormProbe(ИмяФайла) Экспорт
    Перем Конт77;
    Лог77 = СоздатьОбъект("Текст");
    Открыта77 = 0;
    Попытка
        Открыта77 = ОткрытьФорму("Отчет", Конт77, ИмяФайла);
        Лог77.ДобавитьСтроку("form-open=" + Открыта77);
        Если Открыта77 = 1 Тогда
            РФ77 = СоздатьОбъект("РасширениеФормы");
            РФ77.УстановитьФорму(Конт77.Форма);
            Лог77.ДобавитьСтроку("formex-attached");
            Поле77 = РФ77.Фамилия;
            Кнопка77 = РФ77.Harness77Apply;
            Лог77.ДобавитьСтроку("field-id=" + Поле77.Идентификатор);
            Лог77.ДобавитьСтроку("field-handle=" + Поле77.Дескриптор);
            Лог77.ДобавитьСтроку("button-type=" + Кнопка77.Тип);
            Лог77.ДобавитьСтроку("button-formula=" + Кнопка77.Формула);
            Лог77.ДобавитьСтроку("button-readonly=" + Кнопка77.Доступность);
            Лог77.ДобавитьСтроку("button-visible=" + Кнопка77.Видимость);
            Лог77.ДобавитьСтроку("before=" + Конт77.Harness77Snapshot());
            Поле77.Значение = "background-77";
            Лог77.ДобавитьСтроку("after-set=" + Конт77.Harness77Snapshot());
            // Context handler call, not a physical button click.
            С77 = СоздатьОбъект("Сервис");
            Лог77.ДобавитьСтроку("handler-call=" + С77.ВыполнитьПроцедуру(Конт77, "Выполнить"));
            Лог77.ДобавитьСтроку("after-handler=" + Конт77.Harness77Snapshot());
        КонецЕсли;
    Исключение
        Лог77.ДобавитьСтроку("form-error=" + ОписаниеОшибки());
    КонецПопытки;
    Если Открыта77 = 1 Тогда
        Конт77.Форма.Закрыть(0);
        Лог77.ДобавитьСтроку("form-closed");
    КонецЕсли;
    Возврат Лог77.ПолучитьТекст();
КонецФункции
