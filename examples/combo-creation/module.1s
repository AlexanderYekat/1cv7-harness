Процедура Выбор77()
    Вызовы77 = Вызовы77 + 1;
    Сообщить("combo107:" + Строка(Вызовы77) + ":" + Строка(Список77.ТекущаяСтрока()));
КонецПроцедуры

Процедура ПриОткрытии()
    Вызовы77 = 0;
    Список77.ДобавитьЗначение(10, "Первый");
    Список77.ДобавитьЗначение(20, "Второй");
    Список77.ДобавитьЗначение("", "");
    Список77.ДобавитьЗначение(30, "Второй");
    Список77.ТекущаяСтрока(1);
КонецПроцедуры
