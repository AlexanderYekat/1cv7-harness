// Only runs inside the disposable database copy. No form calculations here.
Спр77 = СоздатьОбъект("Справочник.Номенклатура");
Спр77.Новый(); Спр77.Наименование = "Harness77 услуга 105"; Спр77.ТипНоменклатуры = Перечисление.ТипыНоменклатуры.Услуга; Спр77.Записать();
Контр77 = СоздатьОбъект("Справочник.Контрагенты");
Контр77.Новый(); Контр77.УстановитьНовыйКод("77");
Контр77.Наименование = "Harness77 покупатель 105";
Контр77.ПолнНаименование = "Harness77 покупатель 105"; Контр77.Записать();
Дог77 = СоздатьОбъект("Справочник.Договоры");
Дог77.ИспользоватьВладельца(Контр77.ТекущийЭлемент());
Дог77.Новый(); Дог77.УстановитьНовыйКод("77");
Дог77.Наименование = "Harness77 договор 105"; Дог77.ОплатаДоговора = 1; Дог77.Записать();
Подр77 = СоздатьОбъект("Справочник.Подразделения");
Подр77.Новый(); Подр77.УстановитьНовыйКод("77");
Подр77.Наименование = "Harness77 отдел 105"; Подр77.Записать();
НДС77 = СоздатьОбъект("Справочник.СтавкиНДС"); НДС77.Новый(); НДС77.Наименование = "Harness77 ноль 105"; НДС77.Ставка = 0; НДС77.Записать();
НП77 = СоздатьОбъект("Справочник.СтавкиНП"); НП77.Новый(); НП77.Наименование = "Harness77 ноль 105"; НП77.Ставка = 0; НП77.Записать();
Налоги77 = СоздатьОбъект("Справочник.ВариантыРасчетаНалогов"); Налоги77.Новый(); Налоги77.Наименование = "Harness77 без налогов 105"; Налоги77.СтавкаНДС = НДС77.ТекущийЭлемент(); Налоги77.СтавкаНП = НП77.ТекущийЭлемент(); Налоги77.СуммаВключаетНДС = 0; Налоги77.СуммаВключаетНП = 0; Налоги77.Записать();
Док77 = СоздатьОбъект("Документ.ОказаниеУслуг");
Док77.Новый(); Док77.ДатаДок = '01.08.2026';
Док77.Контрагент = Контр77.ТекущийЭлемент();
Док77.Договор = Дог77.ТекущийЭлемент();
Док77.Подразделение2 = Подр77.ТекущийЭлемент();
Док77.ТипУслуги = 1; Док77.ВариантРасчетаНалогов = Налоги77.ТекущийЭлемент();
Док77.ВерсияОбъекта = Константа.НомерРелиза;
Док77.Комментарий = "Harness77 услуги 105";
Для Номер77 = 1 По 2 Цикл
    Док77.НоваяСтрока();
    
    Док77.Услуга = Спр77.ТекущийЭлемент();
    Док77.Количество = 1; Док77.Цена = ?(Номер77 = 1, 50, 30);
    Док77.Сумма = Док77.Цена; Док77.Всего = Док77.Цена;
КонецЦикла;
Док77.Записать();
Возврат Док77.ТекущийДокумент();
