// Only runs inside the disposable database copy. No form calculations here.
Спр77 = СоздатьОбъект("Справочник.Номенклатура");
Спр77.Новый(); Спр77.Наименование = "Harness77 товар 100"; Спр77.Записать();
Контр77 = СоздатьОбъект("Справочник.Контрагенты");
Контр77.Новый(); Контр77.УстановитьНовыйКод("77");
Контр77.Наименование = "Harness77 покупатель 100";
Контр77.ПолнНаименование = "Harness77 покупатель 100"; Контр77.Записать();
Дог77 = СоздатьОбъект("Справочник.Договоры");
Дог77.ИспользоватьВладельца(Контр77.ТекущийЭлемент());
Дог77.Новый(); Дог77.УстановитьНовыйКод("77");
Дог77.Наименование = "Harness77 договор 100"; Дог77.ОплатаДоговора = 1; Дог77.Записать();
Подр77 = СоздатьОбъект("Справочник.Подразделения");
Подр77.Новый(); Подр77.УстановитьНовыйКод("77");
Подр77.Наименование = "Harness77 отдел 100"; Подр77.Записать();
Осн77 = СоздатьОбъект("Документ.РасходнаяНакладная");
Осн77.Новый(); Осн77.ДатаДок = '01.08.2026';
Осн77.Контрагент = Контр77.ТекущийЭлемент(); Осн77.Договор = Дог77.ТекущийЭлемент();
Осн77.Подразделение2 = Подр77.ТекущийЭлемент(); Осн77.ВидОтгрузки = 1;
Осн77.ВерсияОбъекта = Константа.НомерРелиза;
Осн77.Комментарий = "Harness77 основание 100";
Осн77.НоваяСтрока(); Осн77.Товар = Спр77.ТекущийЭлемент();
Осн77.Количество = 1; Осн77.Цена = 80; Осн77.Сумма = 80; Осн77.Всего = 80;
Осн77.Записать();
Док77 = СоздатьОбъект("Документ.СчетФактура");
Док77.Новый(); Док77.ДатаДок = '01.08.2026';
Док77.ДокументОснование = Осн77.ТекущийДокумент();
Док77.Контрагент = Контр77.ТекущийЭлемент();
Док77.Договор = Дог77.ТекущийЭлемент();
Док77.Подразделение2 = Подр77.ТекущийЭлемент();
Док77.ВерсияОбъекта = Константа.НомерРелиза;
Док77.Комментарий = "Harness77 счет-фактура 100";
Для Номер77 = 1 По 2 Цикл
    Док77.НоваяСтрока();
    Док77.НазначитьТип("Товар", "Справочник.Номенклатура");
    Док77.Товар = Спр77.ТекущийЭлемент();
    Док77.Количество = 1; Док77.Цена = ?(Номер77 = 1, 50, 30);
    Док77.Сумма = Док77.Цена; Док77.Всего = Док77.Цена;
КонецЦикла;
Док77.Записать();
Объект77Подготовки = СоздатьОбъект("СписокЗначений");
Объект77Подготовки.ДобавитьЗначение(Док77.ТекущийДокумент());
Объект77Подготовки.ДобавитьЗначение(Осн77.ТекущийДокумент());
Возврат Осн77.ТекущийДокумент();
