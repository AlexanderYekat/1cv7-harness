// A fresh document object reads persisted data using the exact fixture reference.
Док77 = СоздатьОбъект("Документ.СчетФактура");
Если Док77.НайтиДокумент(Объект77) <> 1 Тогда Возврат "{}"; КонецЕсли;
Спр77 = СоздатьОбъект("Справочник.Номенклатура");
Если Спр77.НайтиПоНаименованию("Harness77 товар 100", 0, 1) <> 1 Тогда Возврат "{}"; КонецЕсли;
Ссылки77 = 1; Строки77 = "";
Док77.ВыбратьСтроки();
Пока Док77.ПолучитьСтроку() = 1 Цикл
    Если Док77.Товар <> Спр77.ТекущийЭлемент() Тогда Ссылки77 = 0; КонецЕсли;
    Если Строки77 <> "" Тогда Строки77 = Строки77 + ","; КонецЕсли;
    Строки77 = Строки77 + "{""quantity"":""" + СокрЛП(Строка(Док77.Количество))
        + """,""price"":""" + СокрЛП(Строка(Док77.Цена))
        + """,""amount"":""" + СокрЛП(Строка(Док77.Сумма))
        + """,""total"":""" + СокрЛП(Строка(Док77.Всего))
        + """,""vat"":""" + СокрЛП(Строка(Док77.НДС)) + """}";
КонецЦикла;
Заголовок77 = ?(СокрЛП(Док77.Комментарий) = "Harness77 счет-фактура 100", 1, 0);
Возврат "{""kind"":""СчетФактура"",""posted"":" + Строка(Док77.Проведен())
    + ",""row_count"":" + Строка(Док77.КоличествоСтрок())
    + ",""product_links"":" + Строка(Ссылки77) + ",""comment_ok"":" + Строка(Заголовок77)
    + ",""amount"":""" + СокрЛП(Строка(Док77.Итог("Сумма")))
    + """,""total"":""" + СокрЛП(Строка(Док77.Итог("Всего")))
    + """,""rows"":[" + Строки77 + "]}";
