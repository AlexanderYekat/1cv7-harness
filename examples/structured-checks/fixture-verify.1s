// Тело независимого reader для fixture_verify, а не модуль проведения.
Док77 = СоздатьОбъект("Документ.ГотоваяПродукция");
Если Док77.НайтиДокумент(Объект77) <> 1 Тогда Возврат "{""error"":""document not found""}"; КонецЕсли;
Спр77 = СоздатьОбъект("Справочник.Номенклатура");
Если Спр77.НайтиПоНаименованию("Harness77 продукция 033", 0, 1) <> 1 Тогда
    Возврат "{""error"":""product not found""}";
КонецЕсли;
Строки77 = ""; Ссылки77 = 1;
Док77.ВыбратьСтроки();
Пока Док77.ПолучитьСтроку() = 1 Цикл
    Если Док77.Товар <> Спр77.ТекущийЭлемент() Тогда Ссылки77 = 0; КонецЕсли;
    Если Строки77 <> "" Тогда Строки77 = Строки77 + ","; КонецЕсли;
    Строки77 = Строки77 + "{""quantity"":""" + СокрЛП(Строка(Док77.Количество))
        + """,""price"":""" + СокрЛП(Строка(Док77.Стоимость))
        + """,""amount"":""" + СокрЛП(Строка(Док77.Сумма)) + """}";
КонецЦикла;
Опер77 = СоздатьОбъект("Операция");
Проводки77 = "";
Если Опер77.НайтиОперацию(Объект77) = 1 Тогда
    Опер77.ВыбратьПроводки();
    Пока Опер77.ПолучитьПроводку() = 1 Цикл
        Если Опер77.Дебет.Номенклатура <> Спр77.ТекущийЭлемент() Тогда Ссылки77 = 0; КонецЕсли;
        Если Проводки77 <> "" Тогда Проводки77 = Проводки77 + ","; КонецЕсли;
        Проводки77 = Проводки77 + "{""debit"":""" + СокрЛП(Опер77.Дебет.Счет.Код)
            + """,""credit"":""" + СокрЛП(Опер77.Кредит.Счет.Код)
            + """,""quantity"":""" + СокрЛП(Строка(Опер77.Количество))
            + """,""amount"":""" + СокрЛП(Строка(Опер77.Сумма)) + """}";
    КонецЦикла;
КонецЕсли;
Комментарий77 = СокрЛП(Док77.Комментарий);
Комментарий77 = СтрЗаменить(Комментарий77, "\", "\\");
Комментарий77 = СтрЗаменить(Комментарий77, """", "\""");
Комментарий77 = СтрЗаменить(Комментарий77, Симв(13), "\r");
Комментарий77 = СтрЗаменить(Комментарий77, Симв(10), "\n");
Комментарий77 = СтрЗаменить(Комментарий77, Симв(9), "\t");
Возврат "{""document"":{""posted"":" + Строка(Док77.Проведен())
    + ",""comment"":""" + Комментарий77 + """,""row_count"":" + Строка(Док77.КоличествоСтрок())
    + ",""product_links"":" + Строка(Ссылки77) + ",""rows"":[" + Строки77
    + "]},""entries"":[" + Проводки77 + "]}";
