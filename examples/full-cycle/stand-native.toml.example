# Native stand profile (пример). Скопируйте в локальный файл вне Git и подставьте
# свои пути/хеши. Машинные пути и выбранная база остаются локальными; в общий
# отчёт попадают только имя базы, версия платформы и хеши — без паролей.
#
# Нативный бэкенд вызывает launcher на реальном стенде. Принятый launcher —
# research/platform77/stage4_launcher77.py поверх исследовательского контроллера:
# владение процессом доказывается до Initialize, отдельный desktop, проверяемое
# завершение coordinated-icpp-v1, сохранность чужих сеансов.
schema_version = 1

[stand]
name = "local-7.70.027"
backend = "native"
launcher = "C:/MyProjects/harness77/research/platform77/stage4_launcher77.py"
platform_version = "7.70.027"
screenshots = false

[stand.paths]
exe = "C:/Program Files (x86)/1Cv77/BIN/1cv7l.exe"
cdb = "C:/Program Files (x86)/Windows Kits/10/Debuggers/x86/cdb.exe"
helper = "C:/MyProjects/harness77/.artifacts/platform77/com-coordinated-build-v3-20261011/com_cleanup77.dll"
identity = "C:/MyProjects/harness77/.artifacts/platform77/proxy-challenge-build-20261011/proxy_identity77.dll"

[stand.base]
# Принятый стенд; база используется напрямую, без копирования на каждый прогон.
path = "C:/MyProjects/harness77/.local/bases/base-for-test"
user = "ВВВ"

[stand.pinned]
exe = "562790a34f8491782886e91e36a0800b8fd359afe91bfcf6f575ee4cb181f9bf"
