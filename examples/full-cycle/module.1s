// Пример модуля внешней обработки для полного цикла harness77.
//
// Контракт безголовой проверки (этап 4): форма-отчёт реализует ПриОткрытии со
// СтатусВозврата(0) (форма не показывается) и сообщает маркеры в параметр —
// список значений, первым элементом которого ядро передаёт команду:
//   check   — только загрузка/компиляция;
//   execute — вызов контрольной функции с добавлением value:<результат>.
// Маркеры loaded:harness77 и completed:harness77 постоянны; принадлежность
// результата запуску ядро проверяет по run_id и SHA-256 собранной ERT.
// В симуляционном стенде модуль не исполняется; маркеры нужны нативному прогону.
Функция Harness77Контроль() Экспорт
    Возврат 6 * 7;
КонецФункции

Процедура Выполнить()
КонецПроцедуры

Процедура Очистить()
КонецПроцедуры

Процедура ПриОткрытии()
    СтатусВозврата(0);
    Параметры77 = Форма.Параметр;
    Команда77 = Параметры77.ПолучитьЗначение(1);
    Параметры77.ДобавитьЗначение("loaded:harness77");
    Если Команда77 = "execute" Тогда
        Попытка
            Ответ77 = Harness77Контроль();
            Параметры77.ДобавитьЗначение("value:" + СокрЛП(Строка(Ответ77)));
        Исключение
            Параметры77.ДобавитьЗначение("runtime-error:" + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
    Параметры77.ДобавитьЗначение("completed:harness77");
КонецПроцедуры
